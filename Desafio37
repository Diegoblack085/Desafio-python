n = int(input('Digite o numero que vamos converter: '))
print('''Escolha uma das bases para converter:
[ 1 ] converter para BINARIO
[ 2 ] converter para OCTAL
[ 3 ] converter para HEXADECIMAL''')
opcao = int(input('Sua opção: '))
if opcao == 1:
    print(f'Convertido para binario fica {bin(n)[2:]}')
elif opcao == 2:
    print(f'Convertido para octal fica {oct(n)[2:]}')
elif opcao == 3:
    print(f'Convertido para hexadecimal fica {hex(n)[2:]}')
else:
    print('Essa opção não existe!')
