import random
choices = ['','PEDRA','PAPEL','TESOURA']
comp = random.randint(1,3)
print('====================================')
print('Vamos jogar pedra, papel, tesoura')
print('====================================')
player = input('Digite sua jogada: ').upper().strip()
if player == 'PEDRA':
    player = 1
elif player == 'PAPEL':
    player = 2
elif player == 'TESOURA':
    player = 3
else:
    print('Não tem essa opção!')

if choices[player] == choices[comp]:
    print(f'Empate os dois escolheram {choices[comp]}')

elif choices[player] == 'PEDRA' and choices[comp] == 'PAPEL':
    print(f'O computador ganhou escolhendo {choices[comp]} e o player escolheu {choices[player]}!')

elif choices[player] == 'PAPEL' and choices[comp] == 'PEDRA':
    print(f'O player ganhou escolhendo {choices[player]} e o computador escolheu {choices[comp]}!')

elif choices[player] == 'PEDRA' and choices[comp] == 'TESOURA':
    print(f'O player venceu escolhendo {choices[player]} e o computador {choices[comp]}!')

elif choices[player] == 'TESOURA' and choices[comp] == 'PEDRA':
    print(f'O computador venceu escolhendo {choices[comp]} e o player escolheu {choices[player]}!')

elif choices[player] == 'PAPEL' and choices[comp] == 'PEDRA':
    print(f'O player venceu escolhendo {choices[player]} e o computador {choices[comp]}!')

elif choices[player] == 'PAPEL' and choices[comp] == 'TESOURA':
    print(f'O computador venceu escolhendo {choices[comp]} e o computador {choices[player]}!')
