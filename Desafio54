from datetime import date
maior = 0
menor = 0
ano = date.today().year
print('O ano atual é {}'.format(ano))
for c in range(1,8):
    print('Digite os dados da {}° pessoa'.format(c))
    anoNas = int(input('Digite o ano de nascimento: '))
    idade = ano - anoNas
    if idade >=21:
        maior = maior + 1
    else:
        menor = menor + 1
print('O total de pessoas com mais de 21 anos é {}'.format(maior))
print('O total de pessoas com menos de 21 anos é {}'.format(menor))
