import calendar
from datetime import date
ano = int(input('Digite o ano do seu nascimento: '))
atual = date.today().year - ano
print(f'Você tem {atual} anos')
if atual < 18:
    falta = 18 - atual
    print(f'Você ainda tera que se alistar falta {falta} ano!')
elif atual == 18:
    print('Você deve se alistar!')
elif atual > 18:
    passou = atual - 18
    print(f'O tempo de se alistar passou faz {passou} ano!')
