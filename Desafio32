from datetime import date
print('Vamos saber se é um ano bissexto!')
ano = int(input('Digite o ano que você quer descobrir, Coloque 0 para ver o ano atual: ').strip())
if ano == 0:
    ano = date.today().year
if ano % 4 == 0  or ano % 400 == 0 and ano % 100 == 0 :
    print('O ano {} é um ano bissexto!'.format(ano))
else:
    print('O ano {} NÃO é um ano bissexto!'.format(ano))
